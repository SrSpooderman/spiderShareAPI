# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SpiderShare
APP_VERSION=1.0.0
APP_ENV=local
APP_DEBUG=true
LOG_FORMAT=[pretty, json]
LOG_LEVEL= [DEBUG, INFO, WARNING, ERROR, CRITICAL]
APP_HOST=0.0.0.0
APP_PORT=8000
API_NETWORK_ALIAS=spidershare-api

# Comma-separated browser origins allowed to call the API. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Backoffice
# -----------------------------------------------------------------------------
BACKOFFICE_PORT=5173
BACKOFFICE_API_BASE_URL=http://localhost:8000
BACKOFFICE_PROXY_API_BASE_URL=/api
BACKOFFICE_NETWORK_ALIAS=backoffice

# -----------------------------------------------------------------------------
# Production HTTPS / Nginx
# -----------------------------------------------------------------------------
PROXY_NETWORK_NAME=caddy

API_DOMAIN=api.example.com
BACKOFFICE_DOMAIN=admin.example.com
LETSENCRYPT_EMAIL=admin@example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=600m

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_DATABASE=spidershare
MYSQL_USER=spidershare
MYSQL_PASSWORD=spidershare_password
MYSQL_ROOT_PASSWORD=root_password
DATABASE_URL=mysql+pymysql://spidershare:spidershare_password@mysql:3306/spidershare

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me-before-first-start

OIDC_ENABLED=false
OIDC_ISSUER_URL=https://keycloak.tudominio.com/realms/cliponomicon
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=cliponomicon
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_DEFAULT_ROLE=user

# -----------------------------------------------------------------------------
# Video Storage / Uploads
# -----------------------------------------------------------------------------
VIDEO_STORAGE_PATH=/app/storage/videos
MAX_VIDEO_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_REACTIONS_PER_USER=2
VIDEO_ALLOWED_MIME_TYPES=["video/mp4","video/webm"]

# -----------------------------------------------------------------------------
# Redis / Workers
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
VIDEO_PROCESSING_QUEUE_NAME=video-processing
VIDEO_PROCESSING_MAX_ATTEMPTS=3
VIDEO_PROCESSING_JOB_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Steam
# -----------------------------------------------------------------------------
STEAM_WEB_API_KEY=
STEAM_WEB_API_BASE_URL=https://api.steampowered.com
STEAMGRIDDB_API_KEY=
STEAMGRIDDB_API_BASE_URL=https://www.steamgriddb.com/api/v2
